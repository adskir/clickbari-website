{#- Blocco "Altri servizi": 4 card con mini-infografica verso le altre pagine servizio.
    Uso: {% set current = "siti" %}{% include "altri-servizi.njk" %}
    current: siti | google | seo | automazione | chatgpt
    Opzionali prima dell'include: {% set as_kicker = "..." %}{% set as_title = "...<br>..." %} -#}
{%- set servizi = [
  { id: "siti", href: "/siti-web/", t: "Siti web", d: "Landing page, siti vetrina ed e-commerce su misura.", p: "da 400 €" },
  { id: "google", href: "/google-ecosystem/", t: "Google Ecosystem", d: "Google Ads e Business Profile per farti trovare da chi cerca ora.", p: "da 200 €/mese" },
  { id: "seo", href: "/seo-aeo/", t: "SEO + AEO", d: "Visibilità su Google e nelle risposte dell'AI, che cresce nel tempo.", p: "da 200 €" },
  { id: "automazione", href: "/automazione/", t: "Automazione AI", d: "Chatbot AI sul sito e su WhatsApp: nessun contatto perso.", p: "da 150 €" },
  { id: "chatgpt", href: "/chatgpt-ads/", t: "ChatGPT Ads", d: "La tua pubblicità nelle risposte di ChatGPT. Novità in Italia.", p: "pilota 300 €" }
] -%}
<style>
.as-sec{padding:112px 48px;border-top:1px solid rgba(255,255,255,.09)}
.as-in{max-width:1344px;margin:0 auto}
.as-head{display:block}
.as-kicker{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--blue-bright,#5b9bff);margin-bottom:12px}
.as-title{font-family:var(--font-d,'Bebas Neue',sans-serif);font-weight:400;font-size:clamp(44px,5vw,80px);line-height:.9;letter-spacing:.01em;color:#fff;margin:0}
.as-title span{color:var(--blue-bright,#5b9bff)}
.as-intro{font-size:16px;line-height:1.7;color:#bdbdbd;margin:0}
.as-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;margin-top:48px}
.as-card{display:flex;flex-direction:column;background:var(--gray,#161616);border:1px solid rgba(255,255,255,.09);border-radius:var(--radius-lg,18px);overflow:hidden;text-decoration:none;transition:border-color .25s,transform .25s,box-shadow .25s}
.as-card:hover{border-color:rgba(91,155,255,.5);transform:translateY(-4px);box-shadow:0 18px 40px rgba(0,0,0,.4),0 0 40px rgba(37,99,235,.15)}
.as-vis{position:relative;background:radial-gradient(120% 120% at 0% 0%,rgba(37,99,235,.22),rgba(15,17,21,1) 60%);border-bottom:1px solid rgba(255,255,255,.07);overflow:hidden}
.as-body{display:flex;flex-direction:column;flex:1;padding:22px 22px 20px}
.as-t{font-family:var(--font-d,'Bebas Neue',sans-serif);font-size:28px;letter-spacing:.02em;line-height:1;color:#fff;margin-bottom:8px}
.as-d{flex:1;font-size:14px;line-height:1.6;color:#bdbdbd;margin:0 0 18px}
.as-f{display:flex;justify-content:space-between;align-items:center;gap:10px;padding-top:14px;border-top:1px solid rgba(255,255,255,.07);font-size:13px}
.as-p{color:#fff;font-weight:500}
.as-go{color:var(--blue-bright,#5b9bff);transition:transform .25s}
.as-card:hover .as-go{transform:translateX(4px)}
/* mini-mockup (stile hero delle pagine servizio) */
.as-vis{height:230px}
.as-m{position:absolute;left:22px;right:22px;top:24px;background:#fff;border-radius:12px;box-shadow:0 24px 50px rgba(0,0,0,.55),0 0 0 1px rgba(91,155,255,.35),0 0 40px rgba(37,99,235,.25);color:#1f2937;font-family:var(--font-b,'DM Sans',sans-serif);overflow:hidden;transition:transform .35s}
.as-card:hover .as-m{transform:translateY(-4px)}
.as-chip{position:absolute;z-index:2;display:flex;align-items:center;gap:7px;font-size:10.5px;line-height:1.25;color:#fff;background:rgba(10,12,18,.94);border:1px solid rgba(91,155,255,.45);padding:6px 10px;border-radius:999px;box-shadow:0 8px 24px rgba(0,0,0,.5);white-space:nowrap}
.as-chip i{width:7px;height:7px;border-radius:50%;background:#34d399;box-shadow:0 0 0 3px rgba(52,211,153,.2);flex-shrink:0}
.as-chip.br{right:12px;bottom:14px}.as-chip.tr{right:12px;top:12px}.as-chip.bl{left:12px;bottom:14px}
/* browser */
.as-br{display:flex;align-items:center;gap:5px;padding:7px 10px;background:#f1f3f7;border-bottom:1px solid #e3e7ef}
.as-br i{width:7px;height:7px;border-radius:50%}.as-br i:nth-child(1){background:#ff5f57}.as-br i:nth-child(2){background:#febc2e}.as-br i:nth-child(3){background:#28c840}
.as-br span{margin-left:8px;flex:1;height:14px;border-radius:7px;background:#fff;font-size:8.5px;color:#5f6368;line-height:14px;padding-left:8px}
.as-shot{display:block;width:100%;height:170px;object-fit:cover;object-position:top}
/* google */
.as-q{display:flex;align-items:center;gap:7px;margin:10px 12px 8px;height:24px;border-radius:999px;border:1px solid #e3e7ef;padding:0 10px;font-size:10.5px;color:#1f2937;box-shadow:0 1px 4px rgba(0,0,0,.06)}
.as-q svg{width:11px;height:11px;color:#5f6368;flex-shrink:0}
.as-ad{padding:0 12px 10px}
.as-ad small{display:block;font-size:8.5px;font-weight:700;color:#1f2937;margin-bottom:3px}
.as-ad .u{font-size:8.5px;color:#4d5156;margin-bottom:2px}
.as-ad b{display:block;font-size:12px;font-weight:500;color:#1a0dab;line-height:1.25;margin-bottom:3px}
.as-ad p{margin:0 0 6px;font-size:9px;line-height:1.4;color:#4d5156}
.as-sl{display:grid;grid-template-columns:1fr 1fr;gap:4px 10px}
.as-sl span{font-size:9px;color:#1a0dab}
.as-stars{color:#fbbc04;letter-spacing:1px}
/* seo / ai */
.as-ai{margin:0 12px 8px;padding:8px 10px;border-radius:10px;background:linear-gradient(135deg,#eef3ff,#f6f0ff)}
.as-ai small{display:flex;align-items:center;gap:5px;font-size:8.5px;font-weight:600;color:#5b3fd6;margin-bottom:4px}
.as-ai p{margin:0;font-size:9.5px;line-height:1.45;color:#1f2937}
.as-ai p em{font-style:normal;font-weight:600;color:#2563EB}
.as-org{padding:0 12px 10px}
.as-org .u{font-size:8.5px;color:#4d5156}
.as-org b{display:block;font-size:11.5px;font-weight:500;color:#1a0dab}
/* chat */
.as-ch{display:flex;align-items:center;gap:8px;padding:8px 10px;background:#2563EB;color:#fff}
.as-ch em{width:22px;height:22px;border-radius:50%;background:linear-gradient(135deg,#f5c542,#e08e3c);display:flex;align-items:center;justify-content:center;font-style:normal;font-size:10px;font-weight:700}
.as-ch b{display:block;font-size:10.5px;font-weight:500}.as-ch small{display:block;font-size:8.5px;opacity:.85}
.as-cb{display:flex;flex-direction:column;gap:6px;padding:9px 10px;background:#f6f8fc}
.as-msg{max-width:82%;font-size:9.5px;line-height:1.4;padding:6px 9px;border-radius:11px}
.as-msg.in{align-self:flex-end;background:#2563EB;color:#fff;border-bottom-right-radius:3px}
.as-msg.bot{align-self:flex-start;background:#fff;color:#1f2937;border:1px solid #e6eaf1;border-bottom-left-radius:3px}
/* chatgpt */
.as-gu{align-self:flex-end;margin:10px 10px 6px auto;max-width:80%;background:#f0f2f6;color:#1f2937;font-size:9.5px;line-height:1.4;padding:6px 10px;border-radius:12px 12px 3px 12px;width:fit-content}
.as-ga{padding:0 12px 6px;font-size:9.5px;line-height:1.45;color:#2b2f36}
.as-gad{margin:0 12px 10px;border:1px solid #e3e7ef;border-radius:10px;padding:7px 9px;background:#fafbfd}
.as-gad small{display:block;font-size:7.5px;font-weight:700;letter-spacing:.06em;color:#5f6368;text-transform:uppercase;margin-bottom:5px}
.as-gad div{display:flex;align-items:center;gap:8px}
.as-gad i{width:28px;height:28px;border-radius:7px;background:linear-gradient(160deg,#7cc4f5,#2563EB 55%,#f5c542);flex-shrink:0}
.as-gad b{display:block;font-size:10px;font-weight:500;color:#111}.as-gad span{display:block;font-size:8.5px;color:#4d5156}
.as-gad u{margin-left:auto;text-decoration:none;font-size:8.5px;color:#fff;background:#111;border-radius:999px;padding:4px 9px}
@media(max-width:1100px){.as-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.as-head{grid-template-columns:1fr}}
@media(max-width:768px){.as-sec{padding:80px 20px}.as-grid{grid-template-columns:1fr}}
</style>
<section class="as-sec" aria-labelledby="as-title">
  <div class="as-in">
    <div class="as-head">
      <div>
        <div class="as-kicker">{{ as_kicker or "Altri servizi" }}</div>
        <h2 class="as-title" id="as-title">{{ (as_title or "Tutto quello che serve<br><span>per portare clienti.</span>") | safe }}</h2>
      </div>
    </div>
    <div class="as-grid">
      {%- for s in servizi %}{% if s.id != current %}
      <a href="{{ s.href }}" class="as-card">
        <div class="as-vis" aria-hidden="true">
          {%- if s.id == "siti" %}
          <div class="as-m" style="top:22px;bottom:-30px"><div class="as-br"><i></i><i></i><i></i><span>barmobile.it</span></div><img class="as-shot" src="/img/portfolio/barmobile.webp" alt="" width="1200" height="750" loading="lazy" decoding="async"></div>
          <div class="as-chip br"><i></i>Prima bozza in 24 ore</div>
          {%- elif s.id == "google" %}
          <div class="as-m"><div class="as-q"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>carrozzeria bari</div>
            <div class="as-ad"><small>Sponsorizzato</small><div class="u">carrozzeriafarorosso.it</div><b>Carrozzeria a Bari — Preventivo gratuito in 24 ore</b><p><span class="as-stars">★★★★★</span> 4,8 · Riparazioni dopo incidente, verniciatura</p><div class="as-sl"><span>Preventivo online</span><span>Auto sostitutiva</span></div></div></div>
          <div class="as-chip br"><i></i>In cima alle ricerche</div>
          {%- elif s.id == "seo" %}
          <div class="as-m"><div class="as-q"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>dove mangiare la pizza a Bari?</div>
            <div class="as-ai"><small>✦ Risposta generata dall'AI</small><p>Tra le pizzerie più apprezzate c'è <em>Pizzeria Lievito Lento</em>: impasto a lunga lievitazione e forno a legna.</p></div>
            <div class="as-org"><div class="u">lievitolento.it</div><b>Pizzeria a Bari con forno a legna</b></div></div>
          <div class="as-chip br"><i></i>Citata dall'AI</div>
          {%- elif s.id == "automazione" %}
          <div class="as-m"><div class="as-ch"><em>B</em><div><b>B&amp;B Corte Bianca · Assistente</b><small>Online ora</small></div></div>
            <div class="as-cb"><div class="as-msg in">Avete una camera per 2 dal 12 al 14 maggio?</div><div class="as-msg bot">Sì! Camera con terrazzo, colazione inclusa 😊</div><div class="as-msg in">Perfetto, quanto costa?</div></div></div>
          <div class="as-chip br">📩 Nuova richiesta · Laura</div>
          {%- elif s.id == "chatgpt" %}
          <div class="as-m" style="display:flex;flex-direction:column"><div class="as-gu">Un b&amp;b vicino al mare in Puglia?</div>
            <div class="as-ga">Polignano a Mare e Monopoli sono ottime scelte per una vacanza al mare…</div>
            <div class="as-gad"><small>Sponsorizzato</small><div><i></i><div><b>Masseria Ulivo Blu</b><span>Monopoli · colazione inclusa</span></div><u>Scopri</u></div></div></div>
          <div class="as-chip br"><i></i>Annuncio nella risposta</div>
          {%- endif %}
        </div>
        <div class="as-body">
          <span class="as-t">{{ s.t }}</span>
          <p class="as-d">{{ s.d }}</p>
          <span class="as-f"><span class="as-p">{{ s.p }}</span><span class="as-go">Scopri →</span></span>
        </div>
      </a>
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>
