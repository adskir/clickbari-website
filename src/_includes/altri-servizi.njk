{#- Blocco "Altri servizi": va prima delle FAQ di ogni pagina servizio.
    Uso: {% set current = "siti" %}{% include "altri-servizi.njk" %}
    current: siti | google | chatgpt | seo | automazione -#}
{%- set servizi = [
  { id: "siti", href: "/siti-web/", t: "Siti web", d: "Landing page, siti vetrina ed e-commerce su misura.", p: "da 400 €", ic: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>' },
  { id: "google", href: "/google-ecosystem/", t: "Google Ecosystem", d: "Google Ads e Google Business Profile per clienti locali.", p: "da 200 €/mese", ic: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/>' },
  { id: "seo", href: "/seo-aeo/", t: "SEO + AEO", d: "Visibilità su Google e nelle risposte dell'AI.", p: "da 200 €", ic: '<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>' },
  { id: "automazione", href: "/automazione/", t: "Automazione AI", d: "Chatbot AI sul sito e su WhatsApp, moduli automatici.", p: "da 150 €", ic: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>' },
  { id: "chatgpt", href: "/chatgpt-ads/", t: "ChatGPT Ads", d: "La tua pubblicità nelle risposte di ChatGPT.", p: "pilota 300 €", ic: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/><path d="M9 11h6M9 14h4"/>' }
] -%}
<style>
.as-sec{padding:96px 48px;border-top:1px solid rgba(255,255,255,.09)}
.as-in{max-width:1344px;margin:0 auto}
.as-kicker{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:var(--blue-bright,#5b9bff);margin-bottom:12px}
.as-title{font-family:var(--font-d,'Bebas Neue',sans-serif);font-weight:400;font-size:clamp(40px,4.4vw,68px);line-height:.9;letter-spacing:.01em;color:#fff;margin:0}
.as-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-top:40px}
.as-card{display:flex;flex-direction:column;background:var(--gray,#161616);border:1px solid rgba(255,255,255,.09);border-radius:var(--radius-lg,18px);padding:24px;text-decoration:none;transition:border-color .25s,background .25s,transform .25s}
.as-card:hover{border-color:rgba(91,155,255,.45);background:rgba(37,99,235,.06);transform:translateY(-3px)}
.as-ic{width:42px;height:42px;border-radius:12px;background:rgba(37,99,235,.14);border:1px solid rgba(91,155,255,.3);display:flex;align-items:center;justify-content:center;color:var(--blue-bright,#5b9bff);margin-bottom:18px}
.as-ic svg{width:20px;height:20px}
.as-t{font-family:var(--font-d,'Bebas Neue',sans-serif);font-size:26px;letter-spacing:.02em;line-height:1;color:#fff;margin-bottom:8px}
.as-d{flex:1;font-size:14px;line-height:1.6;color:#bdbdbd;margin:0 0 16px}
.as-f{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:13px}
.as-p{color:#fff;font-weight:500}
.as-go{color:var(--blue-bright,#5b9bff)}
@media(max-width:1100px){.as-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:768px){.as-sec{padding:72px 20px}.as-grid{grid-template-columns:1fr}}
</style>
<section class="as-sec" aria-labelledby="as-title">
  <div class="as-in">
    <div class="as-kicker">Altri servizi</div>
    <h2 class="as-title" id="as-title">Tutto quello che serve<br>per portare clienti.</h2>
    <div class="as-grid">
      {%- for s in servizi %}{% if s.id != current %}
      <a href="{{ s.href }}" class="as-card">
        <span class="as-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ s.ic | safe }}</svg></span>
        <span class="as-t">{{ s.t }}</span>
        <p class="as-d">{{ s.d }}</p>
        <span class="as-f"><span class="as-p">{{ s.p }}</span><span class="as-go">Scopri →</span></span>
      </a>
      {%- endif %}{% endfor %}
    </div>
  </div>
</section>
