<style>
.site-footer{position:relative;background:#0b0b0b;border-top:1px solid rgba(255,255,255,.08);padding:56px 48px 28px;font-family:var(--font-b,'DM Sans',sans-serif)}
.site-footer::before{content:'';position:absolute;top:-1px;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--blue-bright,#5b9bff) 30%,var(--blue-bright,#5b9bff) 70%,transparent);opacity:.45}
.sf-inner{max-width:1344px;margin:0 auto}
.sf-top{display:flex;justify-content:space-between;align-items:flex-end;gap:40px;padding-bottom:36px}
.sf-brand{display:flex;flex-direction:column;gap:16px;max-width:380px}
.sf-logo{display:flex;align-items:center;gap:12px;text-decoration:none}
.sf-logo img{width:38px;height:38px;border-radius:var(--radius-sm,6px);display:block}
.sf-logo b{display:block;font-family:var(--font-d,'Bebas Neue',sans-serif);font-weight:400;font-size:28px;letter-spacing:.06em;color:#fff;line-height:1}
.sf-logo small{display:block;font-size:8px;letter-spacing:.3em;color:var(--blue-bright,#5b9bff);text-transform:uppercase;margin-top:3px}
.sf-tagline{font-size:13px;color:#9a9a9a;line-height:1.7;margin:0}
.sf-contact{display:flex;flex-direction:column;align-items:flex-end;gap:14px}
.sf-links{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:10px;list-style:none;margin:0;padding:0}
.sf-links a{display:inline-flex;align-items:center;gap:9px;height:42px;padding:0 16px;border:1px solid rgba(255,255,255,.14);border-radius:var(--radius-md,10px);font-size:13px;color:#d6d6d6;text-decoration:none;transition:border-color .2s,color .2s,background .2s}
.sf-links a:hover{border-color:var(--blue-bright,#5b9bff);color:#fff;background:rgba(91,155,255,.08)}
.sf-links svg{width:16px;height:16px;flex-shrink:0;color:var(--blue-bright,#5b9bff)}
.sf-addr{display:flex;align-items:center;gap:8px;font-size:12px;color:#8a8a8a;margin:0}
.sf-addr svg{width:14px;height:14px;color:#666}
.sf-bottom{display:flex;justify-content:space-between;align-items:center;gap:16px;border-top:1px solid rgba(255,255,255,.07);padding-top:22px}
.sf-bottom p{font-size:11px;color:#6f6f6f;letter-spacing:.04em;margin:0}
.sf-legal{display:flex;gap:22px;margin-right:76px}
.sf-legal a{font-size:11px;color:#6f6f6f;text-decoration:none;transition:color .2s}
.sf-legal a:hover{color:#fff}
@media(max-width:768px){
  .site-footer{padding:44px 20px 24px}
  .sf-top{flex-direction:column;align-items:flex-start;gap:28px;padding-bottom:28px}
  .sf-contact{align-items:flex-start;width:100%}
  .sf-links{justify-content:flex-start;width:100%}
  .sf-links li{flex:1 1 calc(50% - 5px)}
  .sf-links a{width:100%;justify-content:center}
  .sf-bottom{flex-direction:column-reverse;align-items:flex-start;gap:12px}
  .sf-legal{margin-right:0}
}
</style>
