---
permalink: false
---
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png">
<link rel="icon" type="image/png" sizes="16x16" href="favicon-16.png">
<link rel="apple-touch-icon" sizes="180x180" href="favicon-180.png">
<link rel="icon" type="image/png" sizes="192x192" href="favicon-192.png">
<link rel="shortcut icon" href="favicon.ico">
<title>{{ title }} · ClickBari Blog</title>
<meta name="description" content="{{ excerpt }}">
<link rel="canonical" href="{{ page.url | absoluteUrl }}">
<meta property="og:type" content="article">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ excerpt }}">
<meta property="og:url" content="{{ page.url | absoluteUrl }}">
<meta property="og:site_name" content="ClickBari">
<meta property="og:locale" content="it_IT">
<meta property="og:image" content="https://www.clickbari.it/logo-icon.png">
<meta property="article:published_time" content="{{ date | isoDate }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ excerpt }}">
<script type="application/ld+json">{{ { "url": page.url, "title": title, "excerpt": excerpt, "date": date } | articleJsonLd | safe }}</script>
{% if faq %}<script type="application/ld+json">{{ faq | faqJsonLd | safe }}</script>{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --black:#060606;
  --blue:#2563EB;
  --blue-dark:#1d4ed8;
  --blue-bright:#5b9bff;
  --gray:#161616;
  --gray-mid:#222;
  --font-d:'Bebas Neue',sans-serif;
  --font-b:'DM Sans',sans-serif;
}
html{scroll-behavior:smooth}

body{background:var(--black);color:#fff;font-family:var(--font-b);font-weight:300;overflow-x:hidden}

nav{position:fixed;top:0;left:0;right:0;z-index:100;display:flex;align-items:center;justify-content:space-between;padding:16px 48px;background:rgba(6,6,6,0.92);backdrop-filter:blur(20px);border-bottom:1px solid rgba(255,255,255,0.09)}
.nav-logo{display:flex;align-items:center;gap:10px;text-decoration:none}
.nav-logo-mark{width:36px;height:36px;border-radius:6px;display:flex;align-items:center;justify-content:center;flex-shrink:0;overflow:hidden}
.nav-logo-mark img{width:100%;height:100%;object-fit:cover}
.nav-logo-text{font-family:var(--font-d);font-size:26px;letter-spacing:.06em;color:#fff;line-height:1}
.nav-logo-sub{font-size:8px;letter-spacing:.3em;color:var(--blue-bright);text-transform:uppercase;margin-top:2px}
.nav-links{display:flex;gap:32px;list-style:none}
.nav-links a{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#ddd;text-decoration:none;transition:color .2s}
.nav-links a:hover{color:#fff}
.nav-links a.active{color:#fff}
.nav-cta{background:var(--blue)!important;color:#fff!important;padding:10px 22px;border-radius:2px}

/* HAMBURGER */
.nav-burger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:6px;background:none;border:none;z-index:110}
.nav-burger span{display:block;width:24px;height:2px;background:#fff;border-radius:2px;transition:transform .3s,opacity .3s}
.nav-burger.open span:nth-child(1){transform:translateY(7px) rotate(45deg)}
.nav-burger.open span:nth-child(2){opacity:0}
.nav-burger.open span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

/* MOBILE MENU */
.mobile-menu{display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(6,6,6,0.98);backdrop-filter:blur(20px);z-index:105;flex-direction:column;padding:100px 32px 40px;overflow-y:auto}
.mobile-menu.open{display:flex}
.mobile-nav-list{list-style:none;display:flex;flex-direction:column;gap:4px;flex:1}
.mobile-nav-item{border-bottom:1px solid rgba(255,255,255,0.06)}
.mobile-nav-link{display:flex;align-items:center;justify-content:space-between;padding:16px 0;font-family:var(--font-d);font-size:28px;letter-spacing:.06em;color:#ddd;text-decoration:none;transition:color .2s}
.mobile-nav-link:hover{color:#fff}
.mobile-nav-link.active{color:var(--blue-bright)}
.mobile-cta{display:block;background:var(--blue);color:#fff;text-align:center;padding:16px;font-family:var(--font-d);font-size:22px;letter-spacing:.1em;text-decoration:none;border-radius:2px;margin-top:24px;transition:background .2s;border:none;width:100%;cursor:pointer}
.mobile-cta:hover{background:var(--blue-dark)}

.nav-cta:hover{background:var(--blue-dark)!important}

/* HERO */
.hero{padding:130px 48px 64px;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;top:-100px;right:-100px;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,0.08) 0%,transparent 70%);pointer-events:none}
.hero-tag{display:inline-flex;align-items:center;gap:10px;font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--blue-bright);margin-bottom:20px}
.hero-tag::before{content:'';display:block;width:28px;height:1px;background:var(--blue-bright)}
.hero-title{font-family:var(--font-d);font-size:clamp(52px,7vw,100px);line-height:.9;letter-spacing:.02em;margin-bottom:20px;color:#fff}
.hero-title span{color:var(--blue-bright)}
.hero-desc{font-size:15px;line-height:1.8;color:#ccc;max-width:520px}

/* CATEGORIE */
.categorie{padding:0 48px 64px}
.categorie-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;margin-top:48px}
.cat-card{background:var(--gray);padding:32px 28px;position:relative;overflow:hidden;text-decoration:none;color:#fff;transition:background .3s;display:block}
.cat-card:hover{background:var(--gray-mid)}
.cat-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--blue-bright);transform:scaleX(0);transition:transform .4s;transform-origin:left}
.cat-card:hover::before{transform:scaleX(1)}
.cat-icon{font-size:28px;margin-bottom:16px}
.cat-name{font-family:var(--font-d);font-size:22px;letter-spacing:.04em;color:#fff;margin-bottom:8px}
.cat-desc{font-size:12px;line-height:1.7;color:#888;margin-bottom:16px}
.cat-count{font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#555}
.cat-count span{color:var(--blue-bright)}

/* FILTRI */
.blog-header{padding:0 48px;display:flex;align-items:center;justify-content:space-between;margin-bottom:32px;flex-wrap:wrap;gap:16px}
.filtri{display:flex;gap:8px;flex-wrap:wrap}
.filtro{border:1px solid rgba(255,255,255,0.12);padding:8px 18px;border-radius:2px;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:#aaa;cursor:pointer;transition:all .2s;background:none}
.filtro:hover{border-color:rgba(91,155,255,0.4);color:#ddd}
.filtro.active{background:var(--blue);border-color:var(--blue);color:#fff}
.blog-count{font-size:12px;color:#666;letter-spacing:.06em}

/* ARTICOLI GRID */
.articoli-wrap{padding:0 48px 96px}
.articoli-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:2px}

/* CARD ARTICOLO */
.art-card{background:var(--gray);display:flex;flex-direction:column;transition:background .3s;text-decoration:none;color:#fff;position:relative;overflow:hidden}
.art-card:hover{background:var(--gray-mid)}
.art-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--blue-bright);transform:scaleX(0);transition:transform .4s;transform-origin:left}
.art-card:hover::before{transform:scaleX(1)}

.art-card-top{padding:32px 28px 0}
.art-cat{display:inline-flex;align-items:center;gap:6px;font-size:10px;letter-spacing:.16em;text-transform:uppercase;padding:4px 12px;border-radius:2px;margin-bottom:16px}
.art-cat.siti{background:rgba(37,99,235,0.15);color:var(--blue-bright)}
.art-cat.google{background:rgba(234,67,53,0.12);color:#f87171}
.art-cat.seo{background:rgba(34,197,94,0.1);color:#4ade80}
.art-cat.auto{background:rgba(168,85,247,0.12);color:#c084fc}

.art-title{font-family:var(--font-d);font-size:22px;letter-spacing:.03em;color:#fff;line-height:1.1;margin-bottom:12px}
.art-excerpt{font-size:12px;line-height:1.75;color:#888;flex:1}

.art-card-bottom{padding:20px 28px;border-top:1px solid rgba(255,255,255,0.06);display:flex;align-items:center;justify-content:space-between;margin-top:20px}
.art-meta{display:flex;align-items:center;gap:12px}
.art-date{font-size:11px;color:#555;letter-spacing:.06em}
.art-read{font-size:11px;color:#555}
.art-link{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--blue-bright);display:flex;align-items:center;gap:4px;transition:gap .2s}
.art-card:hover .art-link{gap:8px}

/* CARD COMING SOON */
.art-card.coming{opacity:.5;pointer-events:none}
.art-card.coming .art-title{color:#666}
.coming-badge{position:absolute;top:16px;right:16px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.1);padding:4px 10px;border-radius:2px;font-size:9px;letter-spacing:.16em;text-transform:uppercase;color:#666}

/* NEWSLETTER */
.newsletter{margin:0 48px 64px;background:var(--blue);padding:48px;display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center;border-radius:4px;position:relative;overflow:hidden}
.newsletter::before{content:'📬';position:absolute;right:48px;top:50%;transform:translateY(-50%);font-size:120px;opacity:.08;pointer-events:none}
.newsletter h3{font-family:var(--font-d);font-size:clamp(28px,3.5vw,44px);letter-spacing:.03em;color:#fff;margin-bottom:10px}
.newsletter p{font-size:13px;color:rgba(255,255,255,0.8);line-height:1.7}
.newsletter-form{display:flex;gap:8px}
.newsletter-input{flex:1;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.2);color:#fff;padding:13px 16px;font-family:var(--font-b);font-size:13px;border-radius:2px;outline:none;transition:border-color .2s}
.newsletter-input::placeholder{color:rgba(255,255,255,0.5)}
.newsletter-input:focus{border-color:#fff}
.newsletter-btn{background:#fff;color:var(--blue);border:none;padding:13px 24px;font-family:var(--font-d);font-size:16px;letter-spacing:.1em;cursor:pointer;border-radius:2px;white-space:nowrap;transition:transform .2s}
.newsletter-btn:hover{transform:translateY(-2px)}

/* WA FLOAT */
.wa-float{position:fixed;bottom:28px;right:28px;z-index:200;width:54px;height:54px;background:#25d366;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 20px rgba(37,211,102,0.4);transition:transform .2s;text-decoration:none}
.wa-float:hover{transform:scale(1.1)}
.wa-float svg{width:28px;height:28px;fill:#fff}

footer{background:var(--gray);border-top:1px solid rgba(255,255,255,.09);padding:48px;display:grid;grid-template-columns:1fr 1fr 1fr;gap:48px}
.footer-tagline{font-size:13px;color:#aaa;line-height:1.7;max-width:230px;margin-top:14px}
.footer-col-title{font-size:10px;letter-spacing:.22em;text-transform:uppercase;color:#888;margin-bottom:18px}
.footer-links{list-style:none;display:flex;flex-direction:column;gap:10px}
.footer-links a{font-size:13px;color:#bbb;text-decoration:none;transition:color .2s}
.footer-links a:hover{color:#fff}
.footer-social{display:flex;gap:10px;margin-top:4px}
.social-btn{width:36px;height:36px;border:1px solid rgba(255,255,255,.18);border-radius:2px;display:flex;align-items:center;justify-content:center;font-size:11px;font-family:var(--font-d);text-decoration:none;color:#bbb;transition:border-color .2s,color .2s}
.social-btn:hover{border-color:var(--blue-bright);color:var(--blue-bright)}
.footer-bottom{grid-column:1/-1;border-top:1px solid rgba(255,255,255,.08);padding-top:22px;display:flex;justify-content:space-between;align-items:center}
.footer-bottom p{font-size:11px;color:#888}
.footer-legal{display:flex;gap:22px}
.footer-legal a{font-size:11px;color:#888;text-decoration:none}
.footer-legal a:hover{color:#fff}

.reveal{opacity:0;transform:translateY(20px);transition:opacity .6s ease,transform .6s ease}
.reveal.visible{opacity:1;transform:none}

@media(max-width:768px){
  nav{padding:14px 18px}
  .nav-links{display:none}
  .nav-burger{display:flex}
  .hero{padding:100px 20px 48px}
  .categorie{padding:0 20px 48px}
  .categorie-grid{grid-template-columns:1fr 1fr}
  .blog-header{padding:0 20px}
  .articoli-wrap{padding:0 20px 64px}
  .articoli-grid{grid-template-columns:1fr}
  .newsletter{margin:0 20px 48px;grid-template-columns:1fr;gap:24px;padding:32px 24px}
  .newsletter::before{display:none}
  .newsletter-form{flex-direction:column}
  footer{grid-template-columns:1fr;padding:36px 20px}
  .footer-bottom{flex-direction:column;gap:14px;text-align:center}
  .wa-float{bottom:20px;right:20px;width:48px;height:48px}
}

/* Contact Modal */
.modal-overlay{position:fixed;inset:0;z-index:1000;background:rgba(0,0,0,0.75);backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;padding:20px}
.modal-overlay.visible{display:flex}
.modal-box{position:relative;width:100%;max-width:420px;background:var(--black);border:1px solid rgba(91,155,255,0.25);border-radius:8px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.6)}
.modal-canvas-wrap{position:relative;height:120px;overflow:hidden;border-bottom:1px solid rgba(91,155,255,0.2)}
.modal-canvas-wrap canvas{position:absolute;top:0;left:0;width:100%;height:100%}
.modal-close{position:absolute;top:14px;right:14px;z-index:5;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,0.08);border:none;color:#fff;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s}
.modal-close:hover{background:rgba(255,255,255,0.18)}
.modal-body{padding:28px 28px 32px}
.modal-title{font-family:var(--font-d);font-size:26px;letter-spacing:.04em;color:#fff;margin-bottom:6px}
.modal-sub{font-size:13px;color:#999;margin-bottom:22px;line-height:1.6}
.modal-field{margin-bottom:14px}
.modal-field label{display:block;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#888;margin-bottom:6px}
.modal-field input,.modal-field select{width:100%;background:var(--gray);border:1px solid rgba(255,255,255,0.12);border-radius:4px;padding:12px 14px;color:#fff;font-family:var(--font-b);font-size:14px;outline:none;transition:border-color .2s}
.modal-field input:focus,.modal-field select:focus{border-color:var(--blue-bright)}
.modal-field select{appearance:none;cursor:pointer}
.modal-submit{width:100%;background:var(--blue);color:#fff;border:none;padding:14px;border-radius:4px;font-family:var(--font-b);font-size:13px;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;margin-top:6px;transition:background .2s}
.modal-submit:hover{background:var(--blue-dark)}
.modal-success{display:none;text-align:center;padding:8px 0}
.modal-success.visible{display:block}
.modal-success svg{width:48px;height:48px;margin-bottom:14px}
.modal-success h3{font-family:var(--font-d);font-size:20px;color:#fff;margin-bottom:8px;letter-spacing:.02em}
.modal-success p{font-size:13px;color:#999;line-height:1.6}

@media(max-width:480px){
  .modal-body{padding:22px 20px 26px}
  .modal-canvas-wrap{height:90px}
}

/* POST BODY CONTENT STYLING */
.post-body h2{font-family:var(--font-d);font-size:clamp(24px,3.2vw,34px);letter-spacing:.03em;color:#fff;margin:48px 0 18px;line-height:1.15}
.post-body h3{font-family:var(--font-d);font-size:20px;letter-spacing:.03em;color:#fff;margin:32px 0 12px}
.post-body p{margin-bottom:20px}
.post-body a{color:var(--blue-bright);text-decoration:underline;text-underline-offset:3px}
.post-body ul,.post-body ol{margin:0 0 20px 22px}
.post-body li{margin-bottom:8px}
.post-body strong{color:#fff;font-weight:500}
.post-body img{max-width:100%;height:auto;border-radius:6px;margin:8px 0}
.post-body blockquote{border-left:3px solid var(--blue-bright);padding:4px 20px;margin:24px 0;color:#bbb;font-style:italic}
.post-body table{width:100%;border-collapse:collapse;margin:28px 0;font-size:14px}
.post-body th{text-align:left;font-family:var(--font-d);letter-spacing:.04em;color:var(--blue-bright);padding:10px 14px;border-bottom:2px solid rgba(91,155,255,0.3)}
.post-body td{padding:12px 14px;border-bottom:1px solid rgba(255,255,255,0.08);color:#ddd}
.post-body hr{border:none;border-top:1px solid rgba(255,255,255,0.1);margin:40px 0}

.price-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:2px;margin:28px 0 36px;background:rgba(255,255,255,0.06);border-radius:6px;overflow:hidden}
.price-card{background:var(--gray);padding:24px 18px;text-align:center}
.price-card-label{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:#888;margin-bottom:10px}
.price-card-value{font-family:var(--font-d);font-size:30px;letter-spacing:.02em;color:var(--blue-bright);line-height:1}
.price-card-from{font-size:11px;color:#666;margin-top:4px}

.level-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin:28px 0 36px}
.level-card{background:var(--gray);border:1px solid rgba(255,255,255,0.08);border-radius:8px;padding:24px 20px;position:relative}
.level-card.highlight{border-color:rgba(91,155,255,0.5);background:rgba(37,99,235,0.08)}
.level-badge{position:absolute;top:-10px;right:16px;background:var(--blue);color:#fff;font-size:9px;letter-spacing:.14em;text-transform:uppercase;padding:4px 10px;border-radius:3px}
.level-name{font-family:var(--font-d);font-size:18px;letter-spacing:.03em;color:#fff;margin-bottom:6px}
.level-price{font-size:13px;color:var(--blue-bright);margin-bottom:14px}
.level-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
.level-list li{font-size:12px;color:#999;line-height:1.6;padding-left:16px;position:relative}
.level-list li::before{content:'–';position:absolute;left:0;color:#555}

@media(max-width:600px){
  .price-grid{grid-template-columns:repeat(2,1fr)}
}
</style>
