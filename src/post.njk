<style> #cookie-banner.visible{transform:translateY(0)!important}@media(min-width:600px){ #cookie-banner{padding:20px 48px!important;flex-wrap:nowrap!important}#cookie-banner>div{width:auto!important;max-width:none!important}}</style>
<script>
(function(){
  var STORAGE_KEY = 'cb_consent';
  var banner = document.getElementById('cookie-banner');

  function getConsent(){ return localStorage.getItem(STORAGE_KEY); }

  function updateConsent(granted){
    if (typeof gtag !== 'function') return;
    gtag('consent', 'update', {
      'ad_storage': granted ? 'granted' : 'denied',
      'ad_user_data': granted ? 'granted' : 'denied',
      'ad_personalization': granted ? 'granted' : 'denied',
      'analytics_storage': granted ? 'granted' : 'denied'
    });
    // Notifica GTM: i tag non-Google (es. Meta Pixel) possono
    // agganciarsi a questo evento per verificare di nuovo il consenso
    window.dataLayer.push({'event': 'consent_update'});
  }

  window.cookieAccept = function(){
    localStorage.setItem(STORAGE_KEY,'accepted');
    banner.classList.remove('visible');
    updateConsent(true);
  };

  window.cookieDecline = function(){
    localStorage.setItem(STORAGE_KEY,'declined');
    banner.classList.remove('visible');
    updateConsent(false);
  };

  window.resetCookieConsent = function(){
    localStorage.removeItem(STORAGE_KEY);
    banner.classList.add('visible');
  };

  var consent = getConsent();
  if(!consent){
    setTimeout(function(){ banner.classList.add('visible'); }, 600);
  } else if(consent === 'accepted'){
    updateConsent(true);
  }
})();
</script>

