<script>
(function(){
  var overlay = document.getElementById('contact-modal');
  var formWrap = document.getElementById('modal-form-wrap');
  var successBox = document.getElementById('modal-success');
  var form = document.getElementById('modal-contact-form');
  var serviceSelect = document.getElementById('modal-service');
  var canvas = document.getElementById('modal-canvas');
  var ctx = canvas ? canvas.getContext('2d') : null;
  var particles = [], rafId = null;

  function resizeCanvas(){
    if(!canvas) return;
    var wrap = canvas.parentElement;
    canvas.width = wrap.clientWidth;
    canvas.height = wrap.clientHeight;
  }

  function initParticles(){
    particles = [];
    var count = Math.floor((canvas.width*canvas.height)/9000);
    for(var i=0;i<count;i++){
      particles.push({
        x: Math.random()*canvas.width,
        y: Math.random()*canvas.height,
        vx: (Math.random()-0.5)*0.4,
        vy: (Math.random()-0.5)*0.4,
        r: Math.random()*1.6+0.6
      });
    }
  }

  function drawFrame(){
    if(!ctx) return;
    ctx.clearRect(0,0,canvas.width,canvas.height);
    for(var i=0;i<particles.length;i++){
      var p = particles[i];
      p.x += p.vx; p.y += p.vy;
      if(p.x<0||p.x>canvas.width) p.vx*=-1;
      if(p.y<0||p.y>canvas.height) p.vy*=-1;
    }
    for(var i=0;i<particles.length;i++){
      for(var j=i+1;j<particles.length;j++){
        var a=particles[i], b=particles[j];
        var dx=a.x-b.x, dy=a.y-b.y;
        var dist=Math.sqrt(dx*dx+dy*dy);
        if(dist<70){
          ctx.strokeStyle = 'rgba(91,155,255,'+(0.18*(1-dist/70))+')';
          ctx.lineWidth = 1;
          ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y); ctx.stroke();
        }
      }
    }
    for(var i=0;i<particles.length;i++){
      var p = particles[i];
      ctx.beginPath();
      ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
      ctx.fillStyle = 'rgba(91,155,255,0.85)';
      ctx.fill();
    }
    rafId = requestAnimationFrame(drawFrame);
  }

  function startAnimation(){
    resizeCanvas();
    initParticles();
    if(rafId) cancelAnimationFrame(rafId);
    drawFrame();
  }

  function stopAnimation(){
    if(rafId) cancelAnimationFrame(rafId);
    rafId = null;
  }

  window.openContactModal = function(prefillService){
    overlay.classList.add('visible');
    document.body.style.overflow = 'hidden';
    formWrap.style.display = 'block';
    successBox.classList.remove('visible');
    form.reset();
    if(prefillService && serviceSelect){ serviceSelect.value = prefillService; }
    startAnimation();
  };

  window.closeContactModal = function(){
    overlay.classList.remove('visible');
    document.body.style.overflow = '';
    stopAnimation();
  };

  overlay.addEventListener('click', function(e){
    if(e.target === overlay) closeContactModal();
  });

  form.addEventListener('submit', function(e){
    e.preventDefault();
    var data = new FormData(form);
    var submitBtn = form.querySelector('button[type="submit"]');
    var originalBtnText = submitBtn ? submitBtn.textContent : '';
    fetch(form.action, {
      method: 'POST',
      body: data,
      headers: { 'Accept': 'application/json' }
    }).then(function(res){
      if (res.ok) {
        formWrap.style.display = 'none';
        successBox.classList.add('visible');
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({'event': 'form_submit_success'});
      } else if (submitBtn) {
        submitBtn.textContent = 'Errore, riprova';
        setTimeout(function(){ submitBtn.textContent = originalBtnText; }, 3000);
      }
    }).catch(function(){
      if (submitBtn) {
        submitBtn.textContent = 'Errore, riprova';
        setTimeout(function(){ submitBtn.textContent = originalBtnText; }, 3000);
      }
    });
  });

  window.addEventListener('resize', function(){
    if(overlay.classList.contains('visible')) resizeCanvas();
  });
})();
</script>

<script>
// HAMBURGER MENU
(function(){
  var burger = document.getElementById('burger');
  var mobileMenu = document.getElementById('mobile-menu');
  if(!burger || !mobileMenu) return;

  burger.addEventListener('click', function(){
    burger.classList.toggle('open');
    mobileMenu.classList.toggle('open');
    document.body.style.overflow = mobileMenu.classList.contains('open') ? 'hidden' : '';
  });

  mobileMenu.querySelectorAll('a, button').forEach(function(el){
    el.addEventListener('click', function(){
      burger.classList.remove('open');
      mobileMenu.classList.remove('open');
      document.body.style.overflow = '';
    });
  });
})();
</script>
