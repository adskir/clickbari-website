<body>
<nav>
  <a class="nav-logo" href="/">
    <div class="nav-logo-mark">
      <img src="logo-icon.png" alt="ClickBari">
    </div>
    <div>
      <div class="nav-logo-text">ClickBari</div>
      <div class="nav-logo-sub">Digital · Bari</div>
    </div>
  </a>
  <ul class="nav-links">
    <li><a href="/chi-sono/">Chi sono</a></li>
    <li><a href="/servizi/">Servizi</a></li>
    <li><a href="/portfolio/">Portfolio</a></li>
    <li><a href="/blog/" class="active">Blog</a></li>
    <li><a href="#" class="nav-cta" onclick="openContactModal();return false;">Contattami</a></li>
  </ul>
  <button class="nav-burger" id="burger" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>
<!-- MOBILE MENU -->
<div class="mobile-menu" id="mobile-menu">
  <ul class="mobile-nav-list">
    <li class="mobile-nav-item"><a href="/chi-sono/" class="mobile-nav-link">Chi sono</a></li>
    <li class="mobile-nav-item"><a href="/servizi/" class="mobile-nav-link">Servizi</a></li>
    <li class="mobile-nav-item"><a href="/portfolio/" class="mobile-nav-link">Portfolio</a></li>
    <li class="mobile-nav-item"><a href="/blog/" class="mobile-nav-link active">Blog</a></li>
  </ul>
  <a href="#" onclick="openContactModal();return false;" class="mobile-cta">Contattami →</a>
</div>

<article style="max-width:740px;margin:0 auto;padding:140px 24px 96px;color:#fff;font-family:var(--font-b);font-weight:300;line-height:1.7">
  <div style="font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--blue-bright);margin-bottom:16px">{{ categoryLabel }}</div>
  <h1 style="font-family:var(--font-d);font-size:clamp(32px,5vw,52px);line-height:1.05;margin-bottom:20px;letter-spacing:.01em">{{ title }}</h1>
  <div style="display:flex;gap:16px;color:#888;font-size:13px;margin-bottom:48px">
    <span>{{ date | readableDateIt }}</span>
    <span>·</span>
    <span>{{ readTime }} di lettura</span>
  </div>
  <div style="font-size:17px;color:#ddd" class="post-body">
    {{ content | safe }}
  </div>
  {% if faq %}
