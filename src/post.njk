    <button onclick="cookieAccept()" style="font-family:var(--font-b);font-size:12px;letter-spacing:.12em;text-transform:uppercase;padding:12px 0;border-radius:2px;cursor:pointer;border:none;background:var(--blue);color:#fff;flex:1">Accetta tutti</button>
